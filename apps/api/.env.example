# Chaîne de connexion Postgres directe (pas le protocole proxy prisma+postgres://),
# nécessaire pour @prisma/adapter-pg utilisé par PrismaService.
DATABASE_URL="postgresql://user:password@localhost:5432/hebergeur_jeu"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Pterodactyl (laisser vide tant que le panel n'est pas configuré)
PTERODACTYL_PANEL_URL=""
PTERODACTYL_API_KEY=""
PTERODACTYL_CLIENT_API_KEY=""

# Discord (laisser vide pour désactiver les notifications)
DISCORD_WEBHOOK_URL=""

# App
CORS_ORIGIN="http://localhost:3001"
PORT=3000
NODE_ENV=development
